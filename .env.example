# Copiar a .env y sustituir ambos secretos antes de iniciar.
ADMIN_EMAIL=admin@tecmilenio.mx
ADMIN_PASSWORD=
JUDGE_INVITE_CODE=
# Origen público exacto. En producción debe usar HTTPS.
PUBLIC_ORIGIN=http://localhost:8080
PORT=8080
HOST=127.0.0.1
# Debe apuntar a un volumen persistente del servidor.
DATA_DIR=./storage
# Activar solo detrás de un proxy de confianza que reemplace X-Forwarded-For.
TRUST_PROXY=0
